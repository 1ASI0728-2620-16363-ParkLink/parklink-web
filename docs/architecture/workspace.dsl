workspace "ParkLink architecture" "C4 container view of the current local implementation" {
    model {
        driver = person "Driver" "Finds parking and manages reservations."
        owner = person "Parking owner" "Publishes spaces and monitors activity."
        support = person "Support operator" "Reviews audit records."
        osm = softwareSystem "OpenStreetMap" "Provides map tiles."
        opencode = softwareSystem "OpenCode runtime" "Interprets conversational intents."
        provider = softwareSystem "Payment provider" "Optional provider integration; sandbox is the local default."
        parklink = softwareSystem "ParkLink" "Parking marketplace" {
            mobile = container "Mobile application" "Search, bookings, account and Copilot." "Flutter"
            web = container "Owner dashboard" "Read-only monitoring interface." "React"
            gateway = container "API Gateway" "Authenticates and routes client requests." "NestJS"
            identity = container "Identity service" "Accounts, credentials and roles." "NestJS"
            supply = container "Parking supply service" "Owner publications and revisions." "NestJS"
            discovery = container "Parking discovery service" "Geographic search projection." "NestJS"
            reservation = container "Reservation service" "Holds, availability and reservation state." "NestJS"
            payment = container "Payment service" "Authorization and refund state." "NestJS"
            notification = container "Notification service" "In-app delivery and preferences." "NestJS"
            agent = container "Conversational agent service" "Intent interpretation and human-approved actions." "NestJS"
            audit = container "Audit service" "Append-only event evidence." "NestJS"
            broker = container "Message broker" "Command and event exchanges." "RabbitMQ"
            identitydb = container "Identity database" "Users and password hashes." "PostgreSQL"
            supplydb = container "Supply database" "Publications and revisions." "PostgreSQL"
            discoverydb = container "Discovery database" "Geographic search projection." "PostGIS"
            reservationdb = container "Reservation database" "Operations, holds and reservations." "PostgreSQL"
            paymentdb = container "Payment database" "Payment attempts and refunds." "PostgreSQL"
            notificationdb = container "Notification database" "In-app notifications and preferences." "PostgreSQL"
            agentdb = container "Agent database" "Actor-bound proposals and confirmations." "PostgreSQL"
            auditdb = container "Audit database" "Minimized audit events." "PostgreSQL"
        }
        driver -> mobile "Uses"
        owner -> mobile "Manages publications using"
        owner -> web "Monitors activity using"
        support -> gateway "Queries audit records via"
        mobile -> osm "Loads map tiles from" "HTTPS"
        mobile -> gateway "Calls API" "HTTP/HTTPS"
        web -> gateway "Calls API" "HTTP/HTTPS"
        gateway -> identity "Routes authentication requests" "HTTP"
        gateway -> supply "Routes publication requests" "HTTP"
        gateway -> discovery "Routes search requests" "HTTP"
        gateway -> reservation "Routes reservation requests" "HTTP"
        gateway -> payment "Routes payment queries" "HTTP"
        gateway -> notification "Routes notification requests" "HTTP"
        gateway -> agent "Routes Copilot requests" "HTTP"
        gateway -> audit "Routes audit queries" "HTTP"
        identity -> identitydb "Stores accounts in" "SQL"
        supply -> supplydb "Stores publications in" "SQL"
        discovery -> discoverydb "Stores search projections in" "SQL"
        reservation -> reservationdb "Stores operations and reservations in" "SQL"
        payment -> paymentdb "Stores payment attempts in" "SQL"
        notification -> notificationdb "Stores in-app notifications in" "SQL"
        agent -> agentdb "Stores proposals in" "SQL"
        audit -> auditdb "Stores audit records in" "SQL"
        supply -> broker "Publishes proposed revisions" "AMQP"
        broker -> supply "Delivers revision outcomes" "AMQP"
        broker -> discovery "Delivers supply and reservation events" "AMQP"
        reservation -> broker "Publishes commands and events" "AMQP"
        broker -> reservation "Delivers reservation commands and events" "AMQP"
        payment -> broker "Publishes payment outcomes" "AMQP"
        broker -> payment "Delivers payment commands" "AMQP"
        broker -> notification "Delivers reservation and payment events" "AMQP"
        agent -> broker "Publishes approved commands and events" "AMQP"
        broker -> audit "Delivers domain events" "AMQP"
        agent -> discovery "Requests search results" "HTTP"
        agent -> reservation "Queries operations and reservations" "HTTP"
        agent -> opencode "Requests intent interpretation" "HTTP"
        payment -> provider "Can call provider adapter" "HTTPS"
    }
    views {
        container parklink "Containers" "Owner dashboard in the ParkLink system" {
            include owner web gateway
            autoLayout lr
        }
    }
}
